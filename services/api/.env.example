# Banco: SQLite no dev local, Postgres em produção
DATABASE_URL=sqlite:///./delivery.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/delivery_optimizer

# Troque por um valor aleatório em produção: openssl rand -hex 32
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OSRM público (grátis, com rate limit). Aponte para uma instância própria
# se o volume de requisições crescer.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=10

# Origens liberadas no CORS (separadas por vírgula, "*" libera todas)
CORS_ORIGINS=http://localhost:3000

# J&T Express — sem esta URL a integração roda em modo sandbox (pedidos fake)
JET_API_BASE_URL=
JET_TIMEOUT_SECONDS=15

# Google Geocoding — sem esta key o app sobe normalmente, mas a busca de
# endereços responde "Busca de endereços não configurada".
# Em produção: fly secrets set GOOGLE_MAPS_API_KEY=...
GOOGLE_MAPS_API_KEY=
GEOCODE_TIMEOUT_SECONDS=10
